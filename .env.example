# Copy into .env.local and fill only confirmed public facts. Public variables are baked in at build.
# Leave the canonical URL unset for non-indexable local/staging previews.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_PROFILE=
NEXT_PUBLIC_COMPANY_PROFILE=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_SINCE=
NEXT_PUBLIC_APP_URL=
# Enable only after verifying ownership and the associated privacy disclosure.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Production intake: choose an HTTPS durable receiver OR an absolute persistent-volume directory.
# Receiver must honor Idempotency-Key and return {"accepted":true,"requestId":"same UUID"} after storage.
DEMO_INTAKE_URL=
DEMO_INTAKE_TOKEN=
# Only for a long-running Node server with a persistent volume; not Vercel/serverless.
DEMO_STORAGE_DIR=
# Enable only when your trusted proxy overwrites incoming X-Forwarded-For.
DEMO_TRUST_PROXY=false

# Existing optional Sanity Studio configuration. The public blog uses src/data/articles.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
